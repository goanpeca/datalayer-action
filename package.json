{
  "name": "@datalayer/datalayer-action",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "actions/*"
  ],
  "description": "Composable GitHub Actions that expose the Datalayer (@datalayer/core) TypeScript SDK for CI/CD.",
  "license": "BSD-3-Clause",
  "author": "Datalayer <info@datalayer.io>",
  "homepage": "https://github.com/goanpeca/datalayer-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goanpeca/datalayer-action.git"
  },
  "bugs": {
    "url": "https://github.com/goanpeca/datalayer-action/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "keywords": [
    "datalayer",
    "github-actions",
    "ci",
    "jupyter",
    "runtime",
    "notebook",
    "sdk"
  ],
  "scripts": {
    "type-check": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": ["eslint --fix", "prettier --write"],
    "*.{json,jsonc,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
