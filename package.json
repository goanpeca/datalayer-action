{
  "name": "@datalayer/datalayer-action",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "actions/*"
  ],
  "description": "Composable GitHub Actions that expose the Datalayer (@datalayer/core) TypeScript SDK for CI/CD.",
  "license": "BSD-3-Clause",
  "author": "Datalayer <info@datalayer.io>",
  "homepage": "https://github.com/goanpeca/datalayer-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goanpeca/datalayer-action.git"
  },
  "bugs": {
    "url": "https://github.com/goanpeca/datalayer-action/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@10.9.2",
  "keywords": [
    "datalayer",
    "github-actions",
    "ci",
    "jupyter",
    "runtime",
    "notebook",
    "sdk"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "lint:md": "markdownlint-cli2",
    "lint:spell": "cspell --no-progress \"**/*.{ts,md,yml,yaml,json,jsonc,js,cjs,mjs}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.19.20",
    "@vitest/coverage-v8": "^3.2.4",
    "cspell": "^10.0.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.4",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^3.2.4"
  }
}
