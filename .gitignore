# Dependencies
node_modules/

# TypeScript build output (tsc --build emits per-package lib/)
*.tsbuildinfo
lib/

# Test / coverage output
coverage/
.vitest/

# Generated API docs (TypeDoc)
docs/api/

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Note: per-action `dist/` bundles are committed (GitHub Actions run the bundled
# output), so they are intentionally NOT ignored.
