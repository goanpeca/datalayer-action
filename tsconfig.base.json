{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Datalayer Action — strictest TypeScript base",
  "compilerOptions": {
    // Language & modules (Node 20 / ESM).
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // Project references / emit (per-workspace tsconfigs extend this).
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Strictness — the highest. `strict` enables the core family; the rest are
    // the additional opt-in checks that make this as strict as TypeScript allows.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // Hygiene.
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
